<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Dialling MCP servers and their authorization servers. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- The OAuth redirect lands on a loopback listener (RFC 8252). Nothing
         outside the machine can reach it, but binding a port still counts as
         serving under the hardened runtime. -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
